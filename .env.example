# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron: authorizes /api/cron/cleanup-artwork
CRON_SECRET=

# Resend
RESEND_API_KEY=
ORDER_FROM_EMAIL=onboarding@resend.dev
ORDER_NOTIFICATION_EMAIL=

# Shopify Admin API (custom app, write_draft_orders scope)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_CHECKOUT_DOMAIN=
SHOPIFY_CURRENCY=USD
# Variant IDs of the "Oil Edition (Rolled)" and "Oil Edition (Stretched)" products
SHOPIFY_ROLLED_VARIANT_ID=
SHOPIFY_STRETCHED_VARIANT_ID=
# Used to verify the draft_orders/update webhook's HMAC signature
SHOPIFY_CLIENT_SECRET=

# Optional future anti-spam layer (not wired in yet)
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
